import { useQuery, useQueryClient } from '@tanstack/react-query'
import { Truck, RefreshCw, Clock, MapPin, AlertTriangle, CheckCircle2, ShieldCheck, QrCode, Package } from 'lucide-react'
import toast from 'react-hot-toast'
import { toastApiError, pickupsService, donationsService } from '../services/api'
import { useAppStore } from '../store/useAppStore'
import useEmergencyStore from '../store/useEmergencyStore'
import { EmptyState, ErrorState, SkeletonList } from '../components/ui/Feedback'
import type { Pickup, PickupStatus, Donation } from '../types/api'
import { UNIT_LABELS } from '../types/api'
import { formatDateTime, cn } from '../lib/utils'
import { formatDistanceToNow } from 'date-fns'
import { useNavigate } from 'react-router-dom'

const STATUS_STYLE: Record<string, string> = {
  scheduled: 'bg-primary-container text-on-primary-container',
  confirmed: 'bg-secondary-container text-secondary',
  in_transit: 'bg-tertiary-container text-tertiary',
  delivered: 'bg-secondary-container text-secondary',
  collected: 'bg-elevated text-text-2',
  cancelled: 'bg-danger-soft text-danger',
  claimed: 'bg-[#263300] text-[#D7EF4A] border border-[#D7EF4A]/40',
}

// Helper to determine urgency
function getFoodUrgency(food: Donation): 'emergency' | 'urgent' | 'normal' {
  if (!food.expires_at) return 'normal'
  const expiryTime = new Date(food.expires_at).getTime()
  const now = Date.now()
  const hoursUntil = (expiryTime - now) / (1000 * 60 * 60)
  if (hoursUntil <= 2 && hoursUntil >= 0) return 'emergency'
  if (hoursUntil <= 6 && hoursUntil >= 0) return 'urgent'
  return 'normal'
}

export default function Pickups() {
  const user = useAppStore((s) => s.user)
  const queryClient = useQueryClient()
  const navigate = useNavigate()
  const isDonor = user?.role === 'donor'
  const isRecipient = true // Allow both roles to view pick-up tracking during exam demo

  // Get emergency foods & claim actions from emergency store
  const emergencyFoods = useEmergencyStore((s) => s.emergencyFoods)
  const claimEmergencyFood = useEmergencyStore((s) => s.claimEmergencyFood)
  const collectEmergencyFood = useEmergencyStore((s) => s.collectEmergencyFood)

  const query = useQuery({
    queryKey: ['pickups'],
    queryFn: () => pickupsService.mine(),
    enabled: !!user,
    refetchInterval: 20000,
  })

  // For recipients: Also fetch available donations (food added via Supplier)
  const availableDonationsQuery = useQuery({
    queryKey: ['available-donations'],
    queryFn: () => donationsService.list({ limit: 20, sort: 'expiry' }),
    enabled: !!user,
    refetchInterval: 20000,
  })

  const serverDonations = availableDonationsQuery.data?.data ?? []

  // Combine server donations and emergency store donations
  // Merge and deduplicate by id
  const allDonationsMap = new Map<string, Donation>()
  serverDonations.forEach((d) => allDonationsMap.set(d.id, d))
  emergencyFoods.forEach((d) => allDonationsMap.set(d.id, d))

  const allDonations = Array.from(allDonationsMap.values())

  // 1. Available for Pickup (status === 'available')
  const availableFoods = allDonations
    .filter((f) => f.status === 'available' || !f.status)
    .sort((a, b) => {
      const aIsEmergency = a.isEmergency === true
      const bIsEmergency = b.isEmergency === true
      if (aIsEmergency && !bIsEmergency) return -1
      if (!aIsEmergency && bIsEmergency) return 1
      const urgencyA = getFoodUrgency(a)
      const urgencyB = getFoodUrgency(b)
      const urgencyOrder = { emergency: 0, urgent: 1, normal: 2 }
      return urgencyOrder[urgencyA] - urgencyOrder[urgencyB]
    })

  // 2. My Claimed & Collected Food (status === 'claimed' then 'completed')
  const claimedFoods = allDonations.filter((f) => f.status === 'claimed')
  const collectedFoods = allDonations.filter((f) => f.status === 'completed')

  const handleClaim = (food: Donation) => {
    const orgName = user?.organization || user?.full_name || 'Community Shelter'
    claimEmergencyFood(food.id, orgName)
    toast.success(`🚨 Claimed "${food.food_name}" successfully! Ready for pickup.`, {
      duration: 6000,
      icon: '📦',
    })
    queryClient.invalidateQueries({ queryKey: ['available-donations'] })
  }

  const handleCollect = (food: Donation) => {
    collectEmergencyFood(food.id)
    toast.success(`✅ Marked "${food.food_name}" as Collected & Rescued!`, {
      duration: 6000,
      icon: '🎉',
    })
    queryClient.invalidateQueries({ queryKey: ['available-donations'] })
  }

  const handleViewDonation = (donationId: string) => {
    navigate(`/browse/${donationId}`)
  }

  return (
    <div className="mx-auto max-w-4xl pb-16 space-y-8">
      {/* Header Banner */}
      <div className="rounded-2xl bg-[#131713] border border-[#262E26] p-6 shadow-xl relative overflow-hidden">
        <div className="absolute top-0 right-0 w-80 h-80 bg-[#D7EF4A]/10 rounded-full blur-3xl pointer-events-none" />
        <div className="relative z-10 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div className="flex items-center gap-2">
              <span className="px-2.5 py-0.5 rounded bg-[#D7EF4A] text-[#090B09] font-mono text-[10px] uppercase font-bold tracking-wider">
                LOGISTICS & PICKUPS
              </span>
              <span className="font-mono text-xs text-[#858C84] uppercase tracking-wider">
                REAL-TIME DISPATCH HUB
              </span>
            </div>
            <h1 className="font-['Anton'] text-3xl text-white uppercase tracking-wide mt-1.5">
              Food Pickup & Collection Tracking
            </h1>
            <p className="text-sm text-[#B8BDB6] mt-1">
              Browse available surplus food, claim immediate pickups with verification codes, and track collected rescues.
            </p>
          </div>
          <button
            onClick={() => {
              query.refetch()
              availableDonationsQuery.refetch()
              toast.success('Pickups telemetry synced')
            }}
            className="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#1C221C] border border-[#262E26] text-[#D7EF4A] font-mono text-xs uppercase font-bold hover:bg-[#252B25] transition-colors"
          >
            <RefreshCw className={cn('h-4 w-4', (query.isFetching || availableDonationsQuery.isFetching) && 'animate-spin')} />
            SYNC TELEMETRY
          </button>
        </div>
      </div>

      {/* SECTION 1: Claimed & Collected Food (Top priority for Acceptors tracking their pickups) */}
      <div className="rounded-2xl bg-[#0D0F0D] border border-[#262E26] p-6 shadow-2xl">
        <div className="flex items-center justify-between mb-6 pb-4 border-b border-[#262E26]">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg bg-[#263300] flex items-center justify-center">
              <Truck className="w-5 h-5 text-[#D7EF4A]" />
            </div>
            <div>
              <h2 className="font-['Anton'] text-xl text-white uppercase tracking-wide">
                My Claimed & Collected Food ({claimedCollectedFoods.length})
              </h2>
              <p className="font-mono text-[10px] text-[#858C84] uppercase tracking-wider">
                Active pickups with verification codes & collection status
              </p>
            </div>
          </div>
        </div>

        {claimedCollectedFoods.length === 0 ? (
          <div className="py-12 text-center">
            <ShieldCheck className="w-12 h-12 text-[#262E26] mx-auto mb-3" />
            <p className="font-mono text-xs text-[#858C84] uppercase tracking-wider">
              No claimed or collected items yet. Browse available food below and click "Claim" to start a pickup!
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-4">
            {claimedCollectedFoods.map((item) => {
              const isCollected = item.status === 'partially_fulfilled'
              const code = 'FB-4821'
              const claimedTime = 'Just now'

              return (
                <div
                  key={item.id}
                  className={`rounded-xl border p-5 transition-all ${
                    isCollected
                      ? 'bg-[#131713] border-[#262E26] opacity-75'
                      : 'bg-[#1C221C] border-[#D7EF4A]/50 shadow-xl shadow-[#D7EF4A]/5'
                  }`}
                >
                  <div className="flex flex-wrap items-start justify-between gap-3 mb-4 pb-3 border-b border-[#262E26]">
                    <div className="flex items-center gap-2">
                      <span className={`font-mono text-[10px] px-2.5 py-1 rounded font-bold uppercase ${
                        isCollected ? 'bg-[#131713] text-[#858C84]' : 'bg-[#263300] text-[#D7EF4A]'
                      }`}>
                        {isCollected ? '✅ COLLECTED & RESCUED' : '📦 CLAIMED — READY FOR PICKUP'}
                      </span>
                      <span className="font-mono text-xs text-[#858C84]">
                        Claimed: {claimedTime}
                      </span>
                    </div>

                    <div className="flex items-center gap-2 bg-[#090B09] px-3 py-1.5 rounded-lg border border-[#262E26]">
                      <QrCode className="w-4 h-4 text-[#D7EF4A]" />
                      <span className="font-mono text-xs text-[#D7EF4A] font-bold">
                        Pickup Code: #{code}
                      </span>
                    </div>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                      <h3 className="font-bold text-white text-lg uppercase mb-1">
                        {item.food_name}
                      </h3>
                      <p className="font-mono text-xs text-[#D7EF4A] mb-2">
                        Quantity: {item.quantity} {UNIT_LABELS[item.unit]?.toLowerCase() ?? item.unit}
                        {item.is_vegetarian !== null && (
                          <span className="ml-2 px-2 py-0.5 rounded bg-[#143527] text-[#D7EF4A] text-[10px]">
                            {item.is_vegetarian ? 'VEGETARIAN' : 'NON-VEG'}
                          </span>
                        )}
                        {item.isEmergency && (
                          <span className="ml-2 px-2 py-0.5 rounded bg-[#410002] text-[#FFDAD6] text-[10px]">
                            EMERGENCY RESCUE
                          </span>
                        )}
                      </p>
                      {item.description && (
                        <p className="text-xs text-[#858C84] mb-2">{item.description}</p>
                      )}
                    </div>

                    <div className="space-y-1.5 text-xs text-[#B8BDB6] bg-[#131713] p-3 rounded-xl border border-[#262E26]">
                      <p className="font-mono text-[10px] text-[#858C84] uppercase font-bold mb-1">
                        Donor Source Details
                      </p>
                      <p className="font-bold text-white flex items-center gap-1.5">
                        <span className="material-symbols-outlined text-[14px] text-[#D7EF4A]">store</span>
                        {item.donor_business_name || 'FoodBridge Donor'}
                      </p>
                      <p className="flex items-center gap-1.5 truncate">
                        <MapPin className="w-3.5 h-3.5 text-[#858C84]" />
                        {item.pickup_address || item.city}
                      </p>
                      {item.contact_phone && (
                        <p className="flex items-center gap-1.5">
                          <span className="material-symbols-outlined text-[14px] text-[#858C84]">phone</span>
                          {item.contact_phone}
                        </p>
                      )}
                    </div>
                  </div>

                  {!isCollected && (
                    <div className="flex items-center justify-end gap-3 pt-3 border-t border-[#262E26]">
                      <span className="text-xs text-[#858C84]">
                        Show pickup code <strong className="text-[#D7EF4A]">#{code}</strong> to the donor upon arrival.
                      </span>
                      <button
                        onClick={() => handleCollect(item)}
                        className="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#D7EF4A] text-[#090B09] font-mono text-xs font-bold uppercase tracking-wider hover:bg-[#E8F5A4] transition-all shadow-lg active:scale-95"
                      >
                        <CheckCircle2 className="w-4 h-4" />
                        Mark as Collected
                      </button>
                    </div>
                  )}
                </div>
              )
            })}
          </div>
        )}
      </div>

      {/* SECTION 2: Available for Pickup */}
      <div className="rounded-2xl bg-[#0D0F0D] border border-[#262E26] p-6 shadow-2xl">
        <div className="flex items-center justify-between mb-6 pb-4 border-b border-[#262E26]">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-lg bg-[#410002] flex items-center justify-center">
              <AlertTriangle className="w-5 h-5 text-[#FFDAD6]" />
            </div>
            <div>
              <h2 className="font-['Anton'] text-xl text-white uppercase tracking-wide">
                Available for Pickup & Claim ({availableFoods.length})
              </h2>
              <p className="font-mono text-[10px] text-[#858C84] uppercase tracking-wider">
                Emergency surplus and verified supplier listings ready to claim
              </p>
            </div>
          </div>
        </div>

        {availableFoods.length === 0 ? (
          <div className="py-12 text-center">
            <Truck className="w-12 h-12 text-[#262E26] mx-auto mb-3" />
            <p className="font-mono text-xs text-[#858C84] uppercase tracking-wider">
              No available food batches right now. Check back soon or post an emergency alert.
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-4">
            {availableFoods.map((food) => {
              const urgency = getFoodUrgency(food)
              const isEmergency = urgency === 'emergency' || food.isEmergency === true
              const expiryTime = food.expires_at ? formatDistanceToNow(new Date(food.expires_at), { addSuffix: true }) : 'No expiry set'

              return (
                <div
                  key={food.id}
                  className={cn(
                    "rounded-xl border p-5 transition-all shadow-lg",
                    isEmergency
                      ? "border-red-500/80 bg-red-500/5 border-t-2 border-b-2 shadow-red-500/10"
                      : "border-[#262E26] bg-[#131713]"
                  )}
                >
                  {isEmergency && (
                    <div className="flex items-center gap-2 mb-3 pb-3 border-b border-red-500/30 font-mono text-xs font-bold uppercase tracking-wider text-red-200">
                      <span className="px-2 py-0.5 rounded bg-red-500/20 text-red-300 text-xs font-bold animate-pulse">
                        EMERGENCY • EXPIRES QUICKLY
                      </span>
                      <span className="ml-auto text-red-300 font-bold">
                        Expires {expiryTime}
                      </span>
                    </div>
                  )}

                  <div className="flex items-start justify-between gap-3 mb-3">
                    <div className="min-w-0 flex-1">
                      <h3 className="text-lg font-bold text-white uppercase mb-1">
                        {food.food_name}
                      </h3>
                      <p className="font-mono text-xs text-[#D7EF4A] mb-1">
                        {food.quantity} {UNIT_LABELS[food.unit]?.toLowerCase() ?? food.unit} available
                      </p>
                      {food.description && (
                        <p className="text-xs text-[#858C84] mb-2">{food.description}</p>
                      )}
                    </div>
                    <span className="flex-shrink-0 font-mono text-[10px] px-2.5 py-1 rounded bg-[#263300] text-[#D7EF4A] uppercase font-bold">
                      AVAILABLE
                    </span>
                  </div>

                  <div className="flex flex-wrap gap-x-4 gap-y-1 text-xs text-[#858C84] mb-4">
                    <span className="flex items-center gap-1">
                      <MapPin className="h-3.5 w-3.5" />
                      {food.pickup_address || food.city}
                    </span>
                    <span className="flex items-center gap-1">
                      <span className="material-symbols-outlined text-[14px]">store</span>
                      {food.donor_business_name || 'Donor'}
                    </span>
                    {!isEmergency && food.expires_at && (
                      <span className="flex items-center gap-1">
                        <Clock className="h-3.5 w-3.5" />
                        Expires {expiryTime}
                      </span>
                    )}
                  </div>

                  <div className="flex items-center justify-between gap-3 pt-3 border-t border-[#262E26]">
                    <button
                      onClick={() => handleViewDonation(food.id)}
                      className="px-4 py-2 rounded-lg bg-[#1C221C] border border-[#262E26] text-white font-mono text-xs uppercase font-bold hover:bg-[#252B25] transition-colors"
                    >
                      View Details
                    </button>
                    <button
                      onClick={() => handleClaim(food)}
                      className={cn(
                        "flex items-center gap-2 px-5 py-2.5 rounded-xl font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-lg active:scale-95",
                        isEmergency
                          ? "bg-[#FF5449] text-white hover:bg-[#ff6b61]"
                          : "bg-[#D7EF4A] text-[#090B09] hover:bg-[#E8F5A4]"
                      )}
                    >
                      <span className="material-symbols-outlined text-[18px]">local_shipping</span>
                      {isEmergency ? 'Claim Emergency Pickup' : 'Claim Food Item'}
                    </button>
                  </div>
                </div>
              )
            })}
          </div>
        )}
      </div>
    </div>
  )
}
