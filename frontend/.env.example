# FoodBridge Frontend environment variables
# Copy this file to .env for local development.
# On Vercel, set these values in Project Settings > Environment Variables.

# Render backend API (required at runtime)
VITE_API_URL=https://foodbridge-backend-wu2b.onrender.com/api

# Supabase project (required for authentication; get from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
