# FoodBridge Frontend environment variables
# Copy this file to .env.local for local development.
# On Vercel, set these values in Project Settings > Environment Variables.

# LOCAL PRESENTATION (recommended): point at the local backend.
# The login screen shows "Auto-fill Demo Login" only on localhost / 127.0.0.1.
VITE_API_URL=http://localhost:3001/api

# PRODUCTION alternative:
# VITE_API_URL=https://foodbridge-backend-wu2b.onrender.com/api

# Supabase project (optional for the localhost demo login).
# Leave these unset/empty to use the offline local demo account (user / user).
# Get real values from Supabase Dashboard > Settings > API for cloud auth.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
