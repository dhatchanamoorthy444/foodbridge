# ── FoodBridge Backend — environment template ──
# Copy to .env for local dev. Values below are PLACEHOLDERS only.
# On Render, set the required variables in Dashboard → your service → Environment.

# ═══ LOCAL PRESENTATION / DEMO MODE ═══
# Set DEMO_MODE=true to boot with NO Supabase credentials and enable the local
# demo login at POST /api/auth/demo-login (defaults: user / user).
# The demo user is stored in backend/data/demo-users.json unless MySQL is enabled.
DEMO_MODE=true
DEMO_USERNAME=user
DEMO_EMAIL=user@foodbridge.local
DEMO_PASSWORD=user
# Set to false to use the local JSON store and avoid any MySQL connection attempt.
DEMO_USE_MYSQL=false
# Optional MySQL backing for the demo user (only if DEMO_USE_MYSQL is not false):
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=foodbridge

# ═══ REQUIRED AT BOOT WHEN DEMO_MODE IS OFF — server exits if missing ═══
# SUPABASE_URL     Supabase project URL, e.g. https://<ref>.supabase.co (Dashboard → Settings → API)
# SUPABASE_SERVICE_ROLE_KEY  Api service_role secret. Server-side only; never expose to clients.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ═══ OPTIONAL ═══
# Supabase anon key — only used for the legacy anon client export.
# The API runs fine without it (anon client is null).
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server (Render injects PORT automatically)
NODE_ENV=development
PORT=3001

# CORS — hard-coded Vercel production URL is always allowed; these add extra origins.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Email notifications (SMTP) — optional; SMTP_USER empty disables emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=FoodBridge Notifications <noreply@foodbridge.com>

# Legacy JWT fallback used by routes/inventory.ts only (real auth uses Supabase tokens).
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
